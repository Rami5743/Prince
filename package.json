{
  "name": "prince-web",
  "version": "0.0.0",
  "description": "Porting the 1989/1990 DOS game to run in a web browser.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=web/main.js",
    "watch": "esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=web/main.js --watch",
    "serve": "node tools/dev/serve.mjs 8099 .",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rami5743/Prince.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rami5743/Prince/issues"
  },
  "homepage": "https://github.com/Rami5743/Prince#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true
}
